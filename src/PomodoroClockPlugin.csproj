<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the runtime that PluginApi.dll targets. Logi Plugin Service 6.4.x ships a
         .NET 10 PluginApi, so net8.0 (what the SDK template generates) fails to compile. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Loupedeck.PomodoroClockPlugin</RootNamespace>

    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- False for the same reason as <Private>false</Private> on the PluginApi reference below:
         PluginApi's own dependencies (SkiaSharp shims, Svg, Newtonsoft, YamlDotNet, websocket-sharp)
         are all supplied by the host at runtime. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <PluginApiDir Condition="$(OS) == 'Windows_NT'">C:\Program Files\Logi\LogiPluginService\</PluginApiDir>
    <PluginApiDir Condition="$(OS) != 'Windows_NT'">/Applications/Utilities/LogiPluginService.app/Contents/MonoBundle/</PluginApiDir>

    <PluginDir Condition="$(OS) == 'Windows_NT'">$(LocalAppData)\Logi\LogiPluginService\Plugins\</PluginDir>
    <PluginDir Condition="$(OS) != 'Windows_NT'">~/Library/Application\ Support/Logi/LogiPluginService/Plugins/</PluginDir>

    <BaseOutputPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\bin\'))</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\bin\</OutputPath>

    <PluginShortName>PomodoroClock</PluginShortName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PluginApi">
      <HintPath>$(PluginApiDir)PluginApi.dll</HintPath>
      <!-- Compile against it, but do not copy it into the output. Logi Plugin Service loads the
           plugin into a process that already has PluginApi and its dependencies, so a copy here is
           dead weight (PluginApi alone is 14 MB) and worse, it would ship one service version's
           assemblies to users running another. -->
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyPackage" AfterTargets="PostBuildEvent">
    <Message Text="📦 Copying package files..." Importance="High" />
    <ItemGroup>
      <PackageFiles Include="package\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(OutputPath)..\%(RecursiveDir)" />
    <Message Text="✅ Package files copied to $(OutputPath)..\" Importance="High" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <!-- The .link file makes Logi Plugin Service load the plugin straight out of this build's output
         directory, which is what you want while developing. Build with -p:WritePluginLink=false when
         producing a package: otherwise a Release build silently repoints an existing dev link at
         bin/Release and the installed button stops working. -->
    <Exec Condition="'$(WritePluginLink)' != 'false' AND $(OS) == 'Windows_NT'" Command="echo $(BaseOutputPath)$(Configuration)\ &gt; &quot;$(PluginDir)$(ProjectName).link&quot;" />
    <Exec Condition="'$(WritePluginLink)' != 'false' AND $(OS) != 'Windows_NT'" Command="echo $(BaseOutputPath)$(Configuration)\ &gt; $(PluginDir)$(ProjectName).link" />
    <Message Condition="'$(WritePluginLink)' != 'false'" Text="🔨 Created plugin link at: $(PluginDir)$(ProjectName).link" Importance="High" />

    <!-- Build with -p:ReloadPlugin=false to skip the deep link (needed in headless/CI/sandboxed
         shells, where launching a URL handler can kill the build). Restart Logi Plugin Service by
         hand in that case. -->
    <Message Condition="'$(ReloadPlugin)' != 'false'" Text="🔄 Sending plugin reload command for $(PluginShortName) to Logi Plugin Service" Importance="High" />
    <Exec Condition="'$(ReloadPlugin)' != 'false' AND $(OS) == 'Windows_NT'" Command="start loupedeck:plugin/$(PluginShortName)/reload" ContinueOnError="true" />
    <Exec Condition="'$(ReloadPlugin)' != 'false' AND $(OS) != 'Windows_NT'" Command="open loupedeck:plugin/$(PluginShortName)/reload" ContinueOnError="true" />
    <Message Condition="'$(MSBuildLastTaskResult)' == 'false'" Text="❌ Couldn't reload the plugin, please restart the Logi Plugin Service manually" Importance="High" />
  </Target>

  <Target Name="PluginClean" AfterTargets="CoreClean">
    <Message Text="🧹 Cleaning up plugin link file and output directories..." Importance="High" />

    <Delete Condition="$(OS) == 'Windows_NT'" Files="$(PluginDir)$(ProjectName).link" />
    <Exec Condition="$(OS) != 'Windows_NT'" Command="rm -f $(PluginDir)$(ProjectName).link" />

    <RemoveDir Directories="$(OutputPath)..\" />

    <Message Text="🧼 Plugin link file and output directories have been cleaned!" Importance="High" />
  </Target>

</Project>
